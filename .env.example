# Kaggle API credentials (kaggle.com -> Account -> Create New API Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Path to the kernel folder to push, relative to where main.py runs.
# Defaults to ./kplc-kaggle-notebook, which is bundled in this same repo.
KAGGLE_KERNEL_PATH=./kplc-kaggle-notebook

# Shared secret serve.py checks on its webhook calls. Pick any random
# string (e.g. `openssl rand -hex 32`). You do NOT need to also set this
# as a Kaggle Secret anymore — the backend pushes it to Kaggle
# automatically via a private dataset on every /session/start.
SESSION_WEBHOOK_SECRET=

# The Cloudflare Tunnel token from the tunnel's setup page (Zero Trust ->
# Networks -> Tunnels -> your tunnel -> the long token string). Also no
# longer needs to be set as a Kaggle Secret by hand — pushed automatically.
CLOUDFLARE_TUNNEL_TOKEN=

# Fixed Cloudflare Tunnel hostname, set up once in the Cloudflare Zero
# Trust dashboard (Networks -> Tunnels -> Public Hostname -> localhost:8000).
MODEL_TUNNEL_URL=https://model.yourdomain.com

# Optional: this backend's own public URL, handed to serve.py so it knows
# where to call back. Leave unset on Render — RENDER_EXTERNAL_URL is
# auto-injected and used automatically. Only set this if deploying
# somewhere that doesn't provide that, or for local testing.
BACKEND_URL=

# Optional tuning
SESSION_START_TIMEOUT_SECONDS=600
PROXY_TIMEOUT_SECONDS=120

# Pins the Python version Render builds with. Without this, Render uses
# whatever its current default is, which can outpace prebuilt wheels for
# some dependencies (e.g. pydantic-core) and force a from-source Rust
# build that fails on Render's read-only build filesystem.
PYTHON_VERSION=3.12.7
