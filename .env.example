# Kaggle API credentials (kaggle.com -> Account -> Create New API Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Path to the kernel folder to push, relative to where main.py runs.
# Defaults to ./kplc-kaggle-notebook, which is bundled in this same repo.
KAGGLE_KERNEL_PATH=./kplc-kaggle-notebook

# Shared secret serve.py checks on its webhook calls. Pick any random
# string (e.g. `openssl rand -hex 32`). You do NOT need to also set this
# as a Kaggle Secret anymore — the backend pushes it to Kaggle
# automatically via a private dataset on every /session/start.
SESSION_WEBHOOK_SECRET=

# The Cloudflare Tunnel token from the tunnel's setup page (Zero Trust ->
# Networks -> Tunnels -> your tunnel -> the long token string). Also no
# longer needs to be set as a Kaggle Secret by hand — pushed automatically.
CLOUDFLARE_TUNNEL_TOKEN=

# Fixed Cloudflare Tunnel hostname, set up once in the Cloudflare Zero
# Trust dashboard (Networks -> Tunnels -> Public Hostname -> localhost:8000).
MODEL_TUNNEL_URL=https://model.yourdomain.com

# Optional: this backend's own public URL, handed to serve.py so it knows
# where to call back. Leave unset on Render — RENDER_EXTERNAL_URL is
# auto-injected and used automatically. Only set this if deploying
# somewhere that doesn't provide that, or for local testing.
BACKEND_URL=

# Optional tuning
SESSION_START_TIMEOUT_SECONDS=600
PROXY_TIMEOUT_SECONDS=120

# Pins the Python version Render builds with. Without this, Render uses
# whatever its current default is, which can outpace prebuilt wheels for
# some dependencies (e.g. pydantic-core) and force a from-source Rust
# build that fails on Render's read-only build filesystem.
PYTHON_VERSION=3.12.7

# --- Always-on mode ---------------------------------------------------------
# true  = keep a Kaggle session running at all times. A supervisor thread
#         launches one whenever none is running, and serve.py exits cleanly
#         every RESTART_EVERY_HOURS so it is relaunched fresh. Only the Kaggle
#         session restarts; the Render services are untouched.
# false = original behaviour (start on demand, stop after 15 idle minutes).
AUTO_KEEP_ALIVE=true

# How long a Kaggle session runs before the scheduled restart. Kaggle ends GPU
# sessions at 12h, so values above 11.5 are clamped.
RESTART_EVERY_HOURS=8

# Idle shutdown inside serve.py, in seconds; 0 = never. Defaults to 0 when
# AUTO_KEEP_ALIVE=true and 900 otherwise, so you normally don't set it.
# KAGGLE_IDLE_TIMEOUT_SECONDS=0

# Optional: only LAUNCH sessions inside this UTC window (a running session is
# never cut short by it). Kaggle's free GPU quota is ~30 h/week, so 24/7
# cannot be sustained; e.g. 05:00-13:00 UTC = 08:00-16:00 in Kenya.
# KEEP_ALIVE_WINDOW_UTC=05:00-13:00

# Supervisor tuning (defaults shown)
# SUPERVISOR_INTERVAL_SECONDS=60
# RESTART_RETRY_BACKOFF_SECONDS=300

# --- Several Kaggle accounts, used in turn ----------------------------------
# JSON object of username -> API key (a list of {"username","key"} objects also
# works). When set, it REPLACES KAGGLE_USERNAME / KAGGLE_KEY. Each account
# serves SESSIONS_PER_ACCOUNT launches in a row (3 x 8h = 24h), then the next
# account takes over; after the last one it wraps to the first.
# KAGGLE_ACCOUNTS={"first_user":"first_key","second_user":"second_key","third_user":"third_key"}
# SESSIONS_PER_ACCOUNT=3

# If launches on one account fail this many times in a row (bad key, quota
# used up, ...) the rotation moves on to the next account. 409 conflicts are
# never counted.
# ACCOUNT_SKIP_AFTER_FAILURES=3
